# Copy this file to .env for local development (it's gitignored, so your
# real webhook URL never gets committed).
#
# Get this from: Discord -> Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Anthropic API key, used for LLM scoring (Stage 2) and drafting (Stage 3).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Minimum acceptable salary. Kept out of profile.json because it's personal.
# Postings whose highest posted figure falls below this are rejected; postings
# with no salary listed are never rejected on this basis. Leave unset to skip
# salary filtering entirely.
SALARY_FLOOR=115000
